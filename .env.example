NEXT_PUBLIC_SITE_URL=https://shivamnexa.com

# Lead inbox via Resend email notifications.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
LEAD_REPLY_TO_EMAIL=

# Basic auth for /admin/* and /api/import-pdf (unset = admin disabled)
ADMIN_USER=
ADMIN_PASSWORD=

# Zoho CRM (self-client refresh-token flow). Swap these to move to another org.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Protects /api/cron/retry-leads (Vercel sets this automatically when defined)
CRON_SECRET=

# Sanity write access (lead persistence + imports)
SANITY_API_TOKEN=

# LLM chatbot — production path via Vercel AI Gateway (paid, pass-through provider pricing)
AI_GATEWAY_API_KEY=
# Optional: model string resolved through AI Gateway (default: anthropic/claude-sonnet-5)
CHATBOT_MODEL=

# LLM chatbot — dev path via OpenRouter free-tier models (no cost). When set,
# this takes priority over AI_GATEWAY_API_KEY above. Unset for production.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id, defaults to openai/gpt-oss-20b:free
OPENROUTER_MODEL=
